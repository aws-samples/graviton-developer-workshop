FROM python:3.12-slim

RUN pip install --no-cache-dir \
    pandas==2.2.2 \
    numpy==1.26.4 \
    scipy==1.13.1

# Non-root user
RUN useradd -m -u 1000 sandbox
USER sandbox
WORKDIR /workspace

# Simple HTTP health server that keeps the container alive
CMD ["python", "-c", "from http.server import HTTPServer, BaseHTTPRequestHandler\nimport threading\n\nclass Health(BaseHTTPRequestHandler):\n    def do_GET(self):\n        self.send_response(200)\n        self.end_headers()\n        self.wfile.write(b'{\"status\":\"ready\"}')\n    def log_message(self, *args): pass\n\nHTTPServer(('0.0.0.0', 8888), Health).serve_forever()"]
